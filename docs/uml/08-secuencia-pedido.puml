@startuml
title Secuencia - Gestion de pedidos

actor Mesero
participant "Interfaz" as UI
participant GestorPedidos as Gestor
participant Pedido
participant NotificadorCocina as Cocina
participant NotificadorCaja as Caja
participant NotificadorMesero as AvisoMesero

Mesero -> UI : Crear pedido
UI -> Gestor : crearPedido()
Gestor -> Pedido : crear instancia

Gestor -> Cocina : actualizar(pedido)
Gestor -> Caja : actualizar(pedido)
Gestor -> AvisoMesero : actualizar(pedido)

Gestor --> UI : pedido

loop Por cada producto
    Mesero -> UI : Seleccionar producto
    UI -> Pedido : agregarProducto(producto)
end

UI -> Pedido : getTotal()
Pedido --> UI : total

Mesero -> UI : Cambiar estado
UI -> Gestor : cambiarEstado(pedido, estado)
Gestor -> Pedido : cambiarEstado(estado)

Gestor -> Cocina : actualizar(pedido)
Gestor -> Caja : actualizar(pedido)
Gestor -> AvisoMesero : actualizar(pedido)

UI --> Mesero : Estado actualizado

@enduml
