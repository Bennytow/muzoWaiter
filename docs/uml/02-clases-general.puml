@startuml
title muzoWaiter - Diagrama general de clases
skinparam classAttributeIconSize 0
skinparam shadowing false

package "Presentacion" {
    class ConsolaApp
    class MuzoWaiterGUI
}

package "Servicios" {
    class GestorPedidos
    class CajaRegistradora <<Singleton>>
    class ServicioPromociones
    class ExportadorReporte
    class NotificadorCocina
    class NotificadorCaja
    class NotificadorMesero
}

package "Modelo" {
    interface Producto {
        +getDescripcion(): String
        +getPrecio(): double
    }

    class ProductoBase
    class Combo
    class Pedido {
        -id: int
        -productos: List
        -estado: EstadoPedido
        +agregarProducto(Producto)
        +getTotal(): double
        +cambiarEstado(EstadoPedido)
    }

    enum EstadoPedido {
        RECIBIDO
        EN_PREPARACION
        LISTO
        ENTREGADO
        CANCELADO
    }

    class RegistroPago
    class ReporteCaja
}

package "Patrones" {
    abstract class ProductoDecorator
    class Adicion
    class ComboBuilder
    interface ObservadorPedido
    interface EstrategiaPromocion
    class PromocionHorario
    class PromocionDia
}

Producto <|.. ProductoBase
Producto <|.. Combo
Producto <|.. ProductoDecorator
ProductoDecorator <|-- Adicion
ProductoDecorator --> Producto
Combo o-- "1..*" Producto
ComboBuilder ..> Combo

Pedido o-- "0..*" Producto
Pedido --> EstadoPedido
GestorPedidos o-- "0..*" Pedido
GestorPedidos --> ObservadorPedido

ObservadorPedido <|.. NotificadorCocina
ObservadorPedido <|.. NotificadorCaja
ObservadorPedido <|.. NotificadorMesero

EstrategiaPromocion <|.. PromocionHorario
EstrategiaPromocion <|.. PromocionDia
ServicioPromociones --> EstrategiaPromocion

CajaRegistradora --> Pedido
CajaRegistradora o-- RegistroPago
CajaRegistradora ..> ReporteCaja
CajaRegistradora ..> ExportadorReporte
ReporteCaja o-- RegistroPago
ExportadorReporte ..> ReporteCaja

ConsolaApp --> GestorPedidos
ConsolaApp --> CajaRegistradora
ConsolaApp --> EstrategiaPromocion

MuzoWaiterGUI --> GestorPedidos
MuzoWaiterGUI --> CajaRegistradora
MuzoWaiterGUI --> EstrategiaPromocion

@enduml
