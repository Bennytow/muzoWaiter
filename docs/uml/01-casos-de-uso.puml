@startuml
title muzoWaiter - Casos de uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Mesero
actor Cocina
actor Cajero
actor Administrador

rectangle muzoWaiter {
    usecase "Crear pedido" as UC1
    usecase "Seleccionar producto" as UC2
    usecase "Personalizar producto" as UC3
    usecase "Construir combo" as UC4
    usecase "Consultar pedidos" as UC5
    usecase "Cambiar estado" as UC6
    usecase "Recibir notificaciones" as UC7
    usecase "Seleccionar promocion" as UC8
    usecase "Registrar pago" as UC9
    usecase "Consultar ventas" as UC10
    usecase "Cerrar caja" as UC11
    usecase "Exportar reporte" as UC12
    usecase "Abrir caja" as UC13
}

Mesero --> UC1
Mesero --> UC5
Mesero --> UC6
Mesero --> UC7

Cocina --> UC5
Cocina --> UC6
Cocina --> UC7

Cajero --> UC9
Cajero --> UC7
Cajero --> UC10

Administrador --> UC8
Administrador --> UC10
Administrador --> UC11
Administrador --> UC13

UC1 ..> UC2 : <<include>>
UC3 ..> UC2 : <<extend>>
UC4 ..> UC1 : <<extend>>
UC6 ..> UC7 : <<include>>
UC11 ..> UC12 : <<include>>

@enduml
