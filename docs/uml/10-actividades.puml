@startuml
title Actividades - Flujo de un pedido

start

:Crear pedido;

repeat
    if (Tipo de producto?) then (Individual)
        :Seleccionar producto;
        :Agregar adiciones opcionales;
    else (Combo)
        :Construir combo con Builder;
    endif

    :Agregar al pedido;

repeat while (Agregar otro producto?) is (Si)
-> No;

:Calcular total;

if (Pedido cancelado?) then (Si)
    :Cambiar estado a CANCELADO;
    :Notificar observadores;
    stop
else (No)
    :Cambiar a EN_PREPARACION;
    :Notificar observadores;
    :Cambiar a LISTO;
    :Notificar observadores;
    :Cambiar a ENTREGADO;
    :Notificar observadores;
endif

if (Promocion seleccionada?) then (Si)
    :Calcular descuento aplicable;
endif

:Seleccionar metodo de pago;
:Validar pago;

if (Pago valido?) then (Si)
    :Registrar venta;
else (No)
    :Mostrar error;
endif

stop
@enduml
